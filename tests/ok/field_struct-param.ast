Program
  Struct Point
    Field x i32 mut
    Field y i32 mut
  Fn isXZero bool
    Param p Point
    Block
      Decl zero bool const
        BinOp ==
          Var p.x
          Const 0
      Exit
        Var zero
  Fn sum i32
    Param p Point
    Block
      Exit
        Var p.x
  Decl o Point const
    Const 0
    Const 5
